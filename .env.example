# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Ваш Telegram id (узнать: @userinfobot). Через запятую, если несколько
ADMIN_IDS=123456789
# Пусто = long polling. Для продакшена: https://bot.example.com/webhook
WEBHOOK_URL=
WEBHOOK_SECRET=
# Свой Bot API сервер (telegram-bot-api) снимает лимит 50 МБ до 2 ГБ: http://telegram-bot-api:8081
BOT_API_URL=

# --- Админка ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# openssl rand -hex 32
ADMIN_SECRET_KEY=change-me
# Публичный адрес админки — нужен для трекинга кликов по рекламе: https://admin.example.com
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_TZ=Europe/Moscow

# --- Загрузки ---
# Прокси (резидентные/мобильные) сильно снижают блокировки YouTube/Instagram
YTDLP_PROXY=
# Netscape cookies.txt залогиненного аккаунта — нужен для большинства Instagram-ссылок
YTDLP_COOKIES_FILE=
WORKER_MAX_JOBS=8

# Локальный запуск без Docker:
# DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/bot
# REDIS_URL=redis://localhost:6379/0
